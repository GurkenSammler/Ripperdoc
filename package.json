{
  "name": "ripperdoc",
  "productName": "RIPPERDOC",
  "version": "0.4.0",
  "description": "Mod manager for Cyberpunk 2077",
  "author": "GurkenSammler",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win",
    "pack": "npm run build && electron-builder --win --dir",
    "sounds": "node scripts/make-sounds.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1",
    "icon": "electron scripts/make-icon.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "26.17.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
